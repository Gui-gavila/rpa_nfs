# =============================================================================
# Carol App RPA — Tezk42 (código interno FSB) / Protheus + WireGuard
# =============================================================================
# Copie para .env e preencha. NUNCA versione o .env (só este exemplo).
#
# Perfil deste fork:
#   ERP_TYPE=protheus  RUNTIME_MODE=t3  VPN_MODE=container  VPN_TYPE=WIREGUARD
#   SESSION_TYPE=browser (derivado; normalmente deixe vazio)
# =============================================================================


# --- Eixos principais --------------------------------------------------------

ERP_TYPE=protheus

# t2 = ponte Windows (lab)  |  t3 = container Linux (Carol App)
RUNTIME_MODE=t3

# host      = túnel WireGuard do SO; o agente só verifica (VPN_PROBE_TARGET)
# container = o processo sobe a VPN com wg-quick
VPN_MODE=container

# Vazio = browser (único SESSION_TYPE deste fork)
SESSION_TYPE=

# development | production (controla headless, nível de log e slow-mo)
AGENT_ENV=production


# --- VPN WireGuard -----------------------------------------------------------
#
# ONDE MORA O .conf
#   Preferido: WIREGUARD_CONFIG neste .env (ou segredo da plataforma Carol).
#   Alternativa: ficheiro local NÃO versionado + WIREGUARD_CONFIG_PATH
#                (ex.: secrets/wg0.conf). Nunca commitar o .conf nem as keys.
#   O agente materializa WIREGUARD_CONFIG em runtime (0600) e remove no cleanup.
#
# DENTRO DE WIREGUARD_CONFIG (sem linha "DNS =")
#   Interface: Address, PrivateKey, MTU (opcional)
#   Peer:      PublicKey, PresharedKey (se houver), AllowedIPs,
#              Endpoint, PersistentKeepalive (opcional)
#
# Lab Windows (VPN_MODE=host): não preencha WIREGUARD_CONFIG; use o cliente
# WireGuard do SO + VPN_PROBE_TARGET. Não ligar o mesmo peer no host e no
# container ao mesmo tempo.
# =============================================================================

VPN_TYPE=WIREGUARD
VPN_PROBE_TARGET=
VPN_HOST_WAIT_SECONDS=180
VPN_TIMEOUT_SECONDS=40
VPN_TUN_WAIT_SECONDS=120

WIREGUARD_INTERFACE=wg0
WIREGUARD_CONFIG_PATH=
# Nameservers internos (vírgula), aplicados em /etc/resolv.conf após o túnel.
# Use os valores da linha DNS= do .conf original (essa linha NÃO vai no conf).
WIREGUARD_DNS=
# Exemplo (substitua PrivateKey / PresharedKey; mantenha aspas multilinha):
# WIREGUARD_CONFIG="
# [Interface]
# Address = 10.x.x.x/32
# PrivateKey = <segredo>
# MTU = 1280
#
# [Peer]
# PublicKey = <chave-publica-do-servidor>
# PresharedKey = <segredo-se-houver>
# AllowedIPs = 10.x.0.0/16
# Endpoint = vpn.exemplo.com.br:51820
# PersistentKeepalive = 15
# "
WIREGUARD_CONFIG=


# =============================================================================
# ERP: Protheus (SmartClient Web)
# =============================================================================

PROTHEUS_URL=
PROTHEUS_USERNAME=
PROTHEUS_PASSWORD=
PROTHEUS_PROGRAMA_INICIAL=SIGAFISREM
PROTHEUS_AMBIENTE_SERVIDOR=P
PROTHEUS_RESOURCES_DIR=resources/protheus
PROTHEUS_UI_LOAD_TIMEOUT_S=40

# --- Browser -----------------------------------------------------------------
# O SmartClient Web desenha em canvas e a automação usa coordenadas calibradas:
# mudar o viewport invalida as coordenadas SEM gerar erro.
BROWSER_WIDTH=1280
BROWSER_HEIGHT=720
BROWSER_HEADLESS=1
BROWSER_SLOW_MO_MS=0
BROWSER_LOCALE=pt-BR

# TOTVS Smart Client Web Agent (impressão, ficheiros locais, certificado).
WEB_AGENT_BIN=/opt/web-agent/web-agent
WEB_AGENT_PORT=21021
# Lab Docker Desktop sem .deb na imagem: encaminha ao Web Agent do host.
WEB_AGENT_FORWARD_HOST=
WEB_AGENT_FORWARD_PORT=
DISPLAY=:99


# =============================================================================
# Observabilidade
# =============================================================================

LOG_LEVEL=INFO
LOG_DIR=
LOG_PREFIX=
SCREENSHOTS_DIR=./screenshots

ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_SMTP_FROM=
ALERT_SMTP_TO=
ALERT_SMTP_TLS=1
