# =============================================================================
# Carol App RPA — Tezk42 (FSB) / Protheus + WireGuard
# =============================================================================
# Copie para .env e preencha. NUNCA versione o .env.
#
# T2 lab (Windows):  RUNTIME_MODE=t2  VPN_MODE=host   BROWSER_HEADLESS=0
# T3 Carol/Docker:   RUNTIME_MODE=t3  VPN_MODE=container  BROWSER_HEADLESS=1
# =============================================================================

# --- Eixos -------------------------------------------------------------------
ERP_TYPE=protheus
RUNTIME_MODE=t2
VPN_MODE=host
# Lab sem túnel no processo: SEM_VPN=1 (ignora estágio VPN)
# SEM_VPN=0
VPN_TYPE=WIREGUARD
AGENT_ENV=development

# --- VPN ---------------------------------------------------------------------
# T2/host: túnel no cliente WireGuard do SO; agente só faz probe TCP.
VPN_PROBE_TARGET=
WIREGUARD_INTERFACE=rpa1
# T3/container: peer em ficheiro (secrets/) OU conteúdo em WIREGUARD_CONFIG.
# Nunca commitar .conf. Sem linha "DNS =" no conf — use WIREGUARD_DNS.
WIREGUARD_CONFIG_PATH=secrets/rpa1.conf
WIREGUARD_CONFIG=
WIREGUARD_DNS=

# --- Browser / Web Agent -----------------------------------------------------
BROWSER_HEADLESS=0
BROWSER_SLOW_MO_MS=150
BROWSER_WIDTH=1280
BROWSER_HEIGHT=720
# T3 Docker Desktop sem .deb na imagem: encaminha ao Web Agent do host.
# WEB_AGENT_FORWARD_HOST=host.docker.internal
# WEB_AGENT_FORWARD_PORT=21021

# --- Protheus UI -------------------------------------------------------------
PROTHEUS_URL=
PROTHEUS_USERNAME=
PROTHEUS_PASSWORD=
PROTHEUS_PROGRAMA_INICIAL=SIGACOM
PROTHEUS_AMBIENTE_SERVIDOR=P

# --- Data-plane classificação NF ---------------------------------------------
# fake = lab offline | http = P12 real
PROTHEUS_API_MODE=fake
# Ex.: https://p12.fsbholding.com.br:50000/REST
PROTHEUS_API_BASE_URL=
# Auth Postman FSB: usuario:senha | Basic <b64> | Bearer <tok>
PROTHEUS_API_TOKEN=
PROTHEUS_API_STYLE=generic_query
PROTHEUS_API_TENANT_ID=01
PROTHEUS_AC9_VERIFY=0
# Lab P12: 0 se o certificado intermediário falhar no httpx
PROTHEUS_API_SSL_VERIFY=0
# Listagem SF1 + ValidarMudancaStatus: vazio (produção) | nao_vazio (lab)
PROTHEUS_SF1_STATUS_FILTRO=vazio

LYNN_API_MODE=http
# Host DTA (path montado no client conforme LYNN_RUN_MODE)
LYNN_BASE_URL=https://totvs.dta.totvs.ai
# workflow = Flows homolog | agent = Agents LYNN (produção FSB)
LYNN_RUN_MODE=agent
# api_key = x-dta-api-key | bearer = Authorization JWT | vazio = default por RUN_MODE
# Agente FSB atual: key sk-… via x-dta-api-key (Bearer JWT também suportado se USER_TOKEN for JWT)
LYNN_AUTH_MODE=api_key
# Produção Agents FSB
LYNN_PROJECT=oes-fsb-tezk4200
LYNN_AGENT_ID=06a7ca6b-695c-7a85-8000-b03467ab5833
# Homolog Flows (opcional; usar com LYNN_RUN_MODE=workflow)
LYNN_WORKFLOW_ID=06949a4e-f1c0-7316-8000-f19a7e12776f
# Credencial: colar sk-… ou JWT em LYNN_API_TOKEN (aliases com LYNN_API_KEY)
LYNN_API_TOKEN=
LYNN_API_KEY=
LYNN_API_TIMEOUT_S=120
LYNN_MESSAGE=olá agente

PDF_SHARE_MODE=fake
# Inbox LYNN = {FOLDER_FILES_AGENT_LYNN}\01_NF_Classificar (derivado; não há PDF_SHARE_ROOT)
# Origem TI (UNC FSB): o worker copia ACB_OBJETO daqui → 01_NF_Classificar/{ANOMES}
# Vazio = sem stage (PDFs já na inbox). Produção FSB:
# PDF_SHARE_SOURCE=\\10.250.64.60\rpa$\
PDF_SHARE_SOURCE=
# Opcional: subpastas conhecidas sob a UNC (sem listar). Ex.: 202608,202607
# PDF_SHARE_SOURCE_SUBDIRS=

# Deparas (CR 4.5–4.7). Lab: C:\RPA\depara\NaturezaRendimento.xlsx
# Vencimento especial: xlsx Fiscal com colunas codigo_fornecedor, data_vencimento
# (exemplo de schema em fixtures/depara/vencimento_especial_exemplo.xlsx)
DEPARA_NATUREZA_DESPESA_PATH=
DEPARA_CODIGO_SERVICO_PATH=
DEPARA_NATUREZA_RENDIMENTO_PATH=
DEPARA_VENCIMENTO_ESPECIAL_PATH=

FOLDER_FILES_AGENT_LYNN=C:\AgentLynn\ClassificadorNF
# Casa futura dos artefactos publish (sem consumidores ainda)
FOLDER_WORKER_AGENT_LYNN=C:\AgentLynn\Worker
# Vazio = {FOLDER_FILES_AGENT_LYNN}\01_NF_Classificar\ANOMES (ver caminhos.py)
CLASSIFICAR_NF_CHECKPOINT_DIR=./data/classificar_nf
CLASSIFICAR_NF_WORK_DIR=
CLASSIFICAR_NF_CONTROLE_XLSX=
# Log operacional: vazio = {FOLDER_FILES_AGENT_LYNN}\04_Logs\{YYYYMM}\protheus-YYYYMMDD.log
# Várias corridas no mesmo dia appendam (5 linhas em branco + bloco de sessão).
# LOG_DIR=
# LOG_LEVEL=INFO
# LOG_FILE_LEVEL=INFO
# Screenshot UI: vazio = {FOLDER_FILES_AGENT_LYNN}\05_Screenshots\{YYYYMM}\
# Nome: YYYY-MM-DD-HH-MM-SS_{contexto}.png (mencionado no log).
# SCREENSHOTS_DIR=
# 0 = sem teto (todas as elegíveis da lista SF1, todas as páginas)
# 1+ = bloco da corrida: leftover Pronto UI + próximas N ainda não fechadas no checkpoint
CLASSIFICAR_NF_LIMITE=0
# 1 = um bloco por worker (Carol agenda o próximo); 2+ = repetir no mesmo processo
CLASSIFICAR_NF_CICLOS=1
# 0 = todos os níveis; 3 = Fase 1 (até dia 15). Ops troca na Carol; o worker não altera sozinho.
CLASSIFICAR_NF_NIVEL_MAX=0
CLASSIFICAR_NF_FORCAR=0
CLASSIFICAR_NF_LAB_SEED=0
MATA103_MODO=real

# --- SMTP (opcional; skip se vazio) ------------------------------------------
# REPORT_SMTP_* = e-mail fiscal do lote | ALERT_SMTP_* = falha operacional
# ciclo = a cada worker (lab); esgotado = só quando não restam elegíveis nem Pronto UI
# REPORT_SMTP_FREQUENCIA=ciclo
# REPORT_SMTP_HOST=smtp.exemplo.com
# REPORT_SMTP_PORT=587
# REPORT_SMTP_USER=
# REPORT_SMTP_PASSWORD=
# REPORT_SMTP_FROM=
# REPORT_SMTP_TO=fiscal@exemplo.com
# REPORT_SMTP_TLS=1
# ALERT_SMTP_HOST=
# ALERT_SMTP_TO=

# --- Troca rápida T3 ---------------------------------------------------------
# RUNTIME_MODE=t3
# VPN_MODE=container
# AGENT_ENV=production
# BROWSER_HEADLESS=1
# BROWSER_SLOW_MO_MS=0
# WEB_AGENT_FORWARD_HOST=host.docker.internal
# WEB_AGENT_FORWARD_PORT=21021
